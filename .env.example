# Atlas Voice local configuration
ATLAS_VOICE_HOST=127.0.0.1
ATLAS_REALTIME_HOST=127.0.0.1
ATLAS_VOICE_PORT=8787
ATLAS_VOICE_DATA_DIR=./data
ATLAS_VOICE_MODELS_DIR=./models
ATLAS_VOICE_HF_CACHE=./cache/huggingface
ATLAS_VOICE_ASSISTANT_CONFIG=./config/atlas.assistant.yaml
ATLAS_ASSISTANT_ENABLED=false

# OpenAI-style realtime voice console. TTS providers: none, faster-qwen3-tts, piper.
ATLAS_VOICE_TTS_PROVIDER=faster-qwen3-tts
ATLAS_TTS_BASE_URL=http://127.0.0.1:8008/v1/audio/speech
ATLAS_TTS_HEALTH_URL=http://127.0.0.1:8008/health
ATLAS_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-0.6B-CustomVoice
ATLAS_TTS_VOICE=Aiden
ATLAS_TTS_RESPONSE_FORMAT=wav
ATLAS_TTS_TIMEOUT=60
ATLAS_TTS_HEALTH_TIMEOUT=2
ATLAS_TTS_HOST=127.0.0.1
ATLAS_TTS_PORT=8008
ATLAS_TTS_VENV=.venv-gpu
QWEN_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-0.6B-CustomVoice
QWEN_TTS_SPEAKER=Aiden
QWEN_TTS_LANGUAGE=English
QWEN_TTS_DEVICE=cuda
QWEN_TTS_DTYPE=bfloat16
QWEN_TTS_INSTRUCT=Speak like a warm, grounded conversational partner with natural pacing and gentle emphasis.
ATLAS_VOICE_PIPER_EXECUTABLE=piper
ATLAS_VOICE_PIPER_VOICE=
ATLAS_VOICE_REALTIME_AUDIO_SAMPLE_RATE=24000
ATLAS_VOICE_REALTIME_AUDIO_CHANNELS=1
ATLAS_VOICE_REALTIME_VAD_ENABLED=true
ATLAS_VOICE_REALTIME_VAD_THRESHOLD=500
ATLAS_VOICE_REALTIME_VAD_MIN_SPEECH_MS=200
ATLAS_VOICE_REALTIME_VAD_SILENCE_MS=600

# Ambient listener MVP. Modes: ambient, meeting, direct, private, paused.
ATLAS_VOICE_AMBIENT_SOURCE=mic
ATLAS_VOICE_AMBIENT_MODE=ambient
ATLAS_VOICE_AMBIENT_CHUNK_SECONDS=15
ATLAS_VOICE_AMBIENT_POLL_SECONDS=2
ATLAS_VOICE_AMBIENT_MIC_DEVICE=default
ATLAS_VOICE_AMBIENT_VAD_PROVIDER=auto
ATLAS_VOICE_AMBIENT_VAD_FALLBACK_PROVIDER=energy
ATLAS_VOICE_AMBIENT_VAD_THRESHOLD=500
ATLAS_VOICE_AMBIENT_MIN_SPEECH_SECONDS=0.4
ATLAS_VOICE_AMBIENT_RETAIN_AUDIO=false
ATLAS_VOICE_AMBIENT_RAW_AUDIO_RETENTION_DAYS=0
ATLAS_VOICE_AMBIENT_TRANSCRIPT_RETENTION_DAYS=

# Required for pyannote community diarization model access.
HF_TOKEN=

# If true, missing HF_TOKEN falls back to one speaker so recordings still process.
ATLAS_VOICE_ALLOW_SINGLE_SPEAKER_FALLBACK=false

# ASR / diarization provider defaults. Experimental ASR providers are opt-in.
ATLAS_VOICE_ASR_PROVIDER=whisperx
ATLAS_VOICE_ASR_MODEL=
ATLAS_VOICE_DIARIZATION_PROVIDER=pyannote
ATLAS_VOICE_REALTIME_ASR_PREFER_HYPRWHSPR=true
ATLAS_VOICE_REALTIME_ASR_FALLBACK_PROVIDER=faster-whisper
ATLAS_VOICE_FASTER_WHISPER_MODEL=large-v3-turbo
ATLAS_VOICE_HYPRWHSPR_ENDPOINT=
ATLAS_VOICE_HYPRWHSPR_HEALTH_URL=
ATLAS_VOICE_HYPRWHSPR_VAD_ENDPOINT=
ATLAS_VOICE_HYPRWHSPR_CLI=hyprwhspr
ATLAS_VOICE_HYPRWHSPR_TIMEOUT=10
ATLAS_VOICE_NEMO_SOURCE_LANG=en
ATLAS_VOICE_NEMO_TARGET_LANG=en
ATLAS_VOICE_VIBEVOICE_MODEL=microsoft/VibeVoice-ASR
ATLAS_VOICE_VIBEVOICE_MAX_NEW_TOKENS=32768

# WhisperX / pyannote defaults
WHISPERX_MODEL=large-v3-turbo
WHISPERX_DEVICE=cuda
WHISPERX_COMPUTE_TYPE=float16
PYANNOTE_MODEL=pyannote/speaker-diarization-community-1

# Local llama.cpp OpenAI-compatible endpoint.
LLM_BASE_URL=http://llm:8080/v1/chat/completions
LLM_MODEL=qwen-local
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1200

# Optional AnythingLLM workspace sync. Keep API keys in local .env only.
ANYTHINGLLM_BASE_URL=http://127.0.0.1:3001/api
ANYTHINGLLM_API_KEY=
ANYTHINGLLM_WORKSPACE_SLUG=
ANYTHINGLLM_TIMEOUT=60
ANYTHINGLLM_AUTO_SYNC=false

# Optional path to a local GGUF model. If empty, setup prompts or uses LLM_MODEL_URL.
LLM_MODEL_PATH=
LLM_MODEL_URL=

# Docker build defaults. Override APP_BASE_IMAGE on Jetson if you maintain
# a local L4T/PyTorch image with CUDA-ready Python dependencies.
APP_BASE_IMAGE=python:3.11-slim
LLAMA_CPP_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda

# Development-only shortcut. Leave false for real processing.
ATLAS_VOICE_STUB_MODE=false
